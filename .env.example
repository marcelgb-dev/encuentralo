# Clave de la API de Yelp Fusion (https://www.yelp.com/developers)
YELP_API_KEY=?

# Límite de resultados por búsqueda
MAX_RESULTS=20

# Contraseña del usuario root de MySQL
DB_ROOT_PASSWORD=1234

# true → usa datos locales sin llamar a la API real
MOCK_JSON=false

# Puerto HTTP del host para Nginx
HOST_PORT=80

# Puerto HTTPS del host para Nginx
HOST_PORT_SSL=443

# Zona horaria del servidor (ej: Europe/Madrid)
SERVER_TIMEZONE=Europe/Madrid
